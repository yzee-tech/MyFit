/// One exercise, shared by every routine and workout that uses it. Its name, muscle group and
/// bodyweight share are the same everywhere; routines and workouts keep a copy of them that the
/// server keeps in sync (see $lib/server/exercises.ts)
model Exercise {
  id                 String      @id @default(cuid()) /// @zod.string.cuid2()
  name               String
  targetMuscleGroup  MuscleGroup
  customMuscleGroup  String?
  bodyweightFraction Float?
  /// How to do it, shown wherever it's used
  note               String?
  /// Suggestions only ever add reps, never weight (e.g. sit-ups); a bodyweight share still counts in volume
  repsOnly           Boolean     @default(false)
  /// Reps-only cap: suggestions stop at this many reps; none means no cap
  maxReps            Int?
  /// A machine that shows levels instead of weights: its lowest and highest level, and the step
  /// between them (1 or 0.5). All three or none; never with reps only
  levelsFrom         Float?
  levelsTo           Float?
  levelStep          Float?
  /// A machine with its own weights (a stack): the weights in `machineUnit`, sorted ascending; empty for
  /// none. Never with levels or reps only
  machineWeights     Float[]     @default([])
  /// The unit printed on the machine (KG or LB): its sets always show in it. Set whenever it has weights
  machineUnit        WeightUnit?
  /// An assisted machine: its weights are help (logged as negative loads), or with levels, a higher level
  /// is more help
  assisted           Boolean     @default(false)
  /// Deleted but kept for the workouts that used it
  archived           Boolean     @default(false)
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String

  exerciseTemplates ExerciseTemplate[]
  workoutExercises  WorkoutExercise[]

  @@unique([userId, name])
}
