enum MuscleGroup {
  Chest
  FrontDelts
  SideDelts
  RearDelts
  Lats
  Traps
  Triceps
  Biceps
  Forearms
  Quads
  Hamstrings
  Glutes
  Calves
  Abs
  Neck
  Adductors
  Abductors
  /// Cardio exercises: counted as intervals, left out of the sets-per-muscle charts
  Cardio
  Custom
}

enum SetType {
  Straight
  V2
  Drop
  Down
  Myorep
  MyorepMatch
  MyorepMatchDown
  TopBackoff
}

enum ChangeType {
  Percentage
  AbsoluteLoad
}

enum QuotesDisplayMode {
  PRE_WORKOUT
  POST_WORKOUT
  BETWEEN_SETS
}

/// LEVEL: a machine that shows levels (1, 2, 3…) instead of weights; loads are the level number.
/// Weight sets are KG or LB; a machine's levels are set on its exercise
enum WeightUnit {
  KG
  LB
  LEVEL
}

/// A routine's unit; ASK means choose it when starting a workout (for routines used at many gyms)
enum RoutineWeightUnit {
  KG
  LB
  ASK
}

/// How an exercise is measured: reps with a weight (default), time only, or distance and time
enum ExerciseMeasure {
  Reps
  Time
  DistanceTime
}

/// The unit a DistanceTime exercise's distances are shown in; stored in metres, like loads in kg
enum DistanceUnit {
  KM
  MI
  M
  FT
}
